# Ambiente da API
APP_NAME="Voxy Backend"
APP_ENV=production
APP_VERSION=1.0.0
APP_LOG_LEVEL=info
APP_BASE_URL=https://api.seudominio.com

# Segurança
API_KEY_HEADER=X-Api-Key
API_KEY=troque-por-uma-chave-forte
ALLOWED_ORIGINS=https://app.seudominio.com,https://lovable.so

# Banco de dados (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=voxy
POSTGRES_USER=voxy
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql+psycopg://voxy:troque-esta-senha@postgres:5432/voxy

# Redis / Filas
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Integrações
LOVABLE_WEBHOOK_SECRET=troque-este-segredo
WHATSAPP_PROVIDER=kommo
KOMMO_WEBHOOK_SECRET=troque-este-segredo
ZAPSUITE_WEBHOOK_SECRET=troque-este-segredo

# Observabilidade
SENTRY_DSN=

# CRM/Dashboard
CRM_DEFAULT_STAGE=Novo Lead
AGENT_DEFAULT_STATUS=paused
